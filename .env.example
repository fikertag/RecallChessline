# MongoDB Atlas or Self-hosted Connection String
# IMPORTANT: Include database name (e.g. /learnchess) and retryWrites parameter
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/learnchess?retryWrites=true&w=majority"

# Optional Database Name (defaults to 'learnchess' if omitted)
MONGODB_DB_NAME="learnchess"

# 32+ character secret string for signing JWT session tokens
# Generate one using: openssl rand -hex 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long"

# Public App URL (optional, useful for custom domain redirects)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"

